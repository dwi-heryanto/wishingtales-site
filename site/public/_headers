# Cloudflare Pages response headers (Direct Upload reads this file from the upload root).
# Applied only once the site is deployed; the local preview server does not read it.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), microphone=(), payment=(), usb=()

# Next.js fingerprints everything under /_next/static, so it can be cached hard.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Covers are keyed by slug, not by content hash: a replacement must be picked up.
/covers/*
  Cache-Control: public, max-age=604800

# Social cards are keyed by slug like covers, and change only when a title does.
/og/*
  Cache-Control: public, max-age=604800

# Feeds and the sitemap should not be stale for long.
/sitemap.xml
  Cache-Control: public, max-age=3600

/rss.xml
  Cache-Control: public, max-age=3600
