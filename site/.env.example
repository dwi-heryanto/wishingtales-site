# Public build-time settings for the site. Copy to .env.local for local builds,
# or set them where the build runs (GitHub repository variables, or your shell).

# Canonical origin. Defaults to https://wishingtales.pages.dev — set this only
# once a custom domain actually serves the site, otherwise canonicals and the
# sitemap will point somewhere that does not resolve.
# NEXT_PUBLIC_SITE_URL=https://wishingtales.pages.dev

# A contact address you control. No domain needed. While this is unset the legal
# pages say the address is not published yet, and the build prints a warning.
# NEXT_PUBLIC_CONTACT_EMAIL=

# Cloudflare Web Analytics beacon token. Unset means no analytics script is
# emitted at all — there is no tracking by default.
# NEXT_PUBLIC_CF_BEACON_TOKEN=

# Google Search Console verification tag value, for the HTML-tag method. (The HTML-file
# method needs no variable: drop the file into site/public/.)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster verification tag value (the msvalidate.01 meta tag). Bing's other route
# is a BingSiteAuth.xml file in site/public/.
# NEXT_PUBLIC_BING_SITE_VERIFICATION=
